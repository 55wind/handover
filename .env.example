# LLM: any provider with an OpenAI-compatible chat completions endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=

# PayPal sandbox REST app of the seller (US sandbox business account)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Public address of this deployment, used for PayPal return links
APP_URL=http://localhost:3000

# Development and tests only. Never set these on a hosted demo.
PAYPAL_FAKE=
LLM_SCRIPTED=

# Daily caps, each counted on its own (the values shown are the defaults)
# Clerk replies that use the model
DAILY_CLERK_LIMIT=300
# Settlements that use the model; past this, approved payments are settled by the rules without a model
DAILY_SETTLE_LIMIT=200
# Orders created at PayPal
DAILY_CHECKOUT_LIMIT=400
