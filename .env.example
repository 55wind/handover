# LLM: any provider with an OpenAI-compatible chat completions endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=

# PayPal sandbox REST apps, one per demo merchant. Slot 1 is required; without slots 2 and 3 the merchants share slot 1.
PAYPAL_1_CLIENT_ID=
PAYPAL_1_CLIENT_SECRET=
PAYPAL_2_CLIENT_ID=
PAYPAL_2_CLIENT_SECRET=
PAYPAL_3_CLIENT_ID=
PAYPAL_3_CLIENT_SECRET=

# Development and tests only: in-memory fake PayPal. Never set this on a hosted demo.
PAYPAL_FAKE=

# Cap on demo runs per day
DEMO_DAILY_LIMIT=40
