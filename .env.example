# The language model. Use one of the two providers.
# 1. Claude API (Anthropic's SDK). The model defaults to claude-haiku-5-5, the cheapest current Claude model.
ANTHROPIC_API_KEY=
# 2. Any provider with an OpenAI-compatible chat completions endpoint and tool calling. LLM_MODEL is required here.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Model id. Optional with the Claude API, required otherwise. `npm run eval` shows whether a model is accurate enough and what it costs.
LLM_MODEL=
# Claude API only: how hard the model thinks (low, medium, high). Default low: the agents' jobs are short.
LLM_EFFORT=

# PayPal sandbox REST app of the platform (US sandbox business account)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# One sandbox account that stands for the demo shops' PayPal account. Shops are paid here when a treat is served.
# Without it, what a shop is owed is recorded in the ledger instead of paid.
SHOP_PAYOUT_EMAIL=

# Public address of this deployment, used for PayPal return links and for links to share
APP_URL=http://localhost:3000

# Development and tests only. Never set these on a hosted demo.
PAYPAL_FAKE=
LLM_SCRIPTED=

# Daily caps, each counted on its own (the values shown are the defaults)
# Model runs for senders, for recipients, and at the counter (past the last one, the rules settle without a model)
DAILY_ERRAND_LIMIT=300
DAILY_HOST_LIMIT=300
DAILY_TILL_LIMIT=200
# Orders created at PayPal
DAILY_CHECKOUT_LIMIT=300
